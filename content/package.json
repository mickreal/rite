{
  "name": "rite-content",
  "private": true,
  "type": "module",
  "description": "Content engine for Rite (styles 1, 2 and 6 in docs/gtm-plan.md). Not part of the Worker bundle.",
  "scripts": {
    "check": "bun clips/check-cohorts.ts",
    "clips": "bun clips/render-clip.ts",
    "data": "bun remotion/scripts/build-data.ts",
    "cards": "bash remotion/render-all.sh",
    "export": "bun scripts/export-batch.ts",
    "batch": "TODAY=2026-10-19 bun scripts/render-batch.ts --plan scripts/plan-2026-10-weeks-1-2.json --dest 2026-10-weeks-1-2-v2",
    "batch:w34": "TODAY=2026-11-02 bun scripts/render-batch.ts --plan scripts/plan-2026-11-weeks-3-4.json --dest 2026-11-weeks-3-4",
    "signs": "TODAY=2026-11-02 VIDEOS=all ONLY=videos,signs SIGNS_OUT=../out/signs-2026-v2 bash remotion/render-all.sh",
    "vo-lines": "bun scripts/vo-lines.ts",
    "fonts": "python3 fonts/make-static.py"
  }
}
